{
  "name": "medliga",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MedLiga — jogo de estudo competitivo para estudantes de medicina (embriologia, anatomia, fisiologia...).",
  "scripts": {
    "dev": "vite",
    "build": "npm run validar-conteudo && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "validar-conteudo": "node --experimental-strip-types scripts/validar-conteudo.ts",
    "revisao": "node --experimental-strip-types scripts/estado-revisao.ts",
    "test:sql": "bash scripts/testar-sql.sh",
    "seed": "node --experimental-strip-types scripts/gerar-seed.ts",
    "icones": "node scripts/gerar-icones.cjs",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "ios": "npm run build && npx cap sync ios && npx cap open ios"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@supabase/supabase-js": "^2.119.0",
    "dexie": "^4.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "three": "^0.187.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.2.1",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
